# Copy to .env and fill in. Never commit .env.

# PostgreSQL (source of truth): the system Postgres (14+). No Docker.
# One-time setup:
#   sudo -u postgres psql -c "CREATE ROLE promise_monitor LOGIN PASSWORD '<password>';" \
#                         -c "CREATE DATABASE promise_monitor OWNER promise_monitor;"
PM_DATABASE_URL=postgresql+psycopg://promise_monitor:<password>@localhost:5432/promise_monitor

# Receives run-failure and schema alerts; also the default coordinator for unassigned meters.
PM_ADMIN_EMAIL=

# dev | prod
PM_ENV=dev

PM_LOG_DIR=logs
PM_LOG_LEVEL=INFO

# Google Sheets review queue (P6). Create a service account with the Sheets API enabled,
# download its JSON key OUTSIDE this repo (or name it *.service-account.json, which is git-ignored),
# and share the spreadsheet with the service account's email as Editor.
PM_REVIEW_SPREADSHEET_ID=
PM_GOOGLE_SERVICE_ACCOUNT_FILE=

# Email (P7): coordinator digests + admin alerts over SMTP (TLS always).
# TESTING with the Mailtrap sandbox (captures every email; nothing is delivered):
#   PM_SMTP_HOST=sandbox.smtp.mailtrap.io   PM_SMTP_PORT=2525 (or 587; 465 = implicit TLS)
#   PM_SMTP_USER / PM_SMTP_PASSWORD = the inbox's SMTP credentials (Mailtrap → Sandboxes → your inbox → SMTP)
#   PM_SMTP_FROM=promise-monitor@example.org   (any address; the sandbox doesn't check it)
# PRODUCTION with Gmail (free):
# Needs 2-Step Verification on the sending account, then an App Password:
# https://myaccount.google.com/apppasswords  (16 characters, no spaces)
PM_SMTP_HOST=smtp.gmail.com
PM_SMTP_PORT=587
PM_SMTP_USER=
PM_SMTP_PASSWORD=
PM_SMTP_FROM=

# Admin dashboard (P10). Generate a secret with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
PM_DASHBOARD_SECRET=
# Set to true once served over HTTPS (e.g. on the VPS behind a reverse proxy).
PM_DASHBOARD_HTTPS=false

# P12 Promise Tracker submissions: encrypts coordinators' tokens at rest. Generate once with
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing it makes every saved token unreadable (coordinators must paste theirs again).
PM_TOKEN_KEY=
