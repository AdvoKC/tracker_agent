# Copy to .env and fill in. Never commit .env.

# PostgreSQL (source of truth): the system Postgres (14+). No Docker.
# One-time setup:
#   sudo -u postgres psql -c "CREATE ROLE promise_monitor LOGIN PASSWORD '<password>';" \
#                         -c "CREATE DATABASE promise_monitor OWNER promise_monitor;"
PM_DATABASE_URL=postgresql+psycopg://promise_monitor:<password>@localhost:5432/promise_monitor

# Receives run-failure and schema alerts; also the default coordinator for unassigned meters.
PM_ADMIN_EMAIL=

# dev | prod
PM_ENV=dev

PM_LOG_DIR=logs
PM_LOG_LEVEL=INFO
