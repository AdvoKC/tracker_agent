    "blog": "<h1 class=\"zw-paragraph heading0\" data-header=\"0\" data-textformat=\"{&quot;size&quot;:&quot;12.00&quot;,&quot;fgc&quot;:&quot;rgb(0, 0, 0)&quot;,&quot;type&quot;:&quot;text&quot;}\" data-margin-bottom=\"12pt\" data-margin-top=\"12pt\" data-hd-info=\"0\" data-line-height=\"1.2\" data-doc-id=\"2500059000000789010\" data-doc-type=\"writer\"><strong><span style=\"font-size: 12pt; font-family: helvetica, arial, sans-serif;\">National Health Act (Amendment) Bill, 2023 Presented to the House</span></strong></h1>\r\n<p class=\"zw-paragraph heading0\" data-header=\"0\" data-textformat=\"{&quot;size&quot;:&quot;12.00&quot;,&quot;fgc&quot;:&quot;rgb(0, 0, 0)&quot;,&quot;type&quot;:&quot;text&quot;}\" data-margin-bottom=\"12pt\" data-margin-top=\"12pt\" data-hd-info=\"0\" data-line-height=\"1.2\">&nbsp;</p>\r\n<p><span style=\"font-size: 10pt; font-family: helvetica, arial, sans-serif;\">On Wednesday, November 1, 2023, the National Health Act (Amendment) Bill, 2023 sponsored by Hon. Adesola Samuel Adedayo was presented for first reading on the floor of the house.</span></p>",
